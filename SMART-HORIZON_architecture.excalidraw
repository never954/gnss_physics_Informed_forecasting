      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "hypothesis space fixed by physics (admissible periods)\nper-window period: gap-tolerant Lomb-Scargle, corridor-bounded\nbeat periods derived by formula, not searched\ncandidates: level estimators + harmonic orders\nbasis chosen by held-out day-7 self-validation\nridge regression on all 7 days · runaway clamp\noutputs mean + 1σ · no stored weights (fits per window)",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "originalText": "hypothesis space fixed by physics (admissible periods)\nper-window period: gap-tolerant Lomb-Scargle, corridor-bounded\nbeat periods derived by formula, not searched\ncandidates: level estimators + harmonic orders\nbasis chosen by held-out day-7 self-validation\nridge regression on all 7 days · runaway clamp\noutputs mean + 1σ · no stored weights (fits per window)",
      "lineHeight": 1.3,
      "baseline": 13
    },
