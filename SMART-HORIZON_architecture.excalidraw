      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "orbit class → period (GEO sidereal · MEO per-constellation)\nECEF ⊗ Earth rotation → beat frequencies\nx, y split into two beats · z keeps orbital period\nclock = random walk + resets → no harmonics on clock\nperiods verified on periodogram before fitting",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "originalText": "orbit class → period (GEO sidereal · MEO per-constellation)\nECEF ⊗ Earth rotation → beat frequencies\nx, y split into two beats · z keeps orbital period\nclock = random walk + resets → no harmonics on clock\nperiods verified on periodogram before fitting",
      "lineHeight": 1.3,
      "baseline": 13
    },
